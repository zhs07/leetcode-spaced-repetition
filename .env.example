# Local SQLite remains the default. Hosted mode requires every setting below.
TRACKER_MODE=hosted
TRACKER_DATABASE_URL=postgresql://runtime-role:REPLACE_LOCALLY@pooler-host:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
TRACKER_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Migration credentials are separate and only used by migrate.py.
# TRACKER_MIGRATION_DATABASE_URL=postgresql://migration-role:REPLACE_LOCALLY@host:5432/postgres
